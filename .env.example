# Kredensial untuk WhatsApp Bot (Fonnte API)
# Salin file ini menjadi '.env' di server VPS Anda dan sesuaikan isinya.

# API Token dari Fonnte
WA_TOKEN=TokenFonnteAndaDiSini

# Target WhatsApp Group ID atau Nomor HP (Opsional, jika kosong default ke grup baru)
TARGET_PHONE=120363410041245092@g.us

# Alamat aplikasi AGRI-PAM. Ubah jika ganti domain atau pengujian lokal
# (contoh lokal: http://localhost:5173).
AGRIPAM_BASE_URL=https://agri-pam.id

# Token baca OPSIONAL untuk API privat /api/v1/publik/belum-lapor.
# Halaman /publik/* dapat dibuka tanpa login/token; jika dikosongkan,
# bot otomatis membaca daftar region belum lapor dari DOM halaman.
# PUBLIC_READ_TOKEN=TokenBacaPublikDiSini

# Override opsional per halaman (kosongkan agar otomatis memakai AGRIPAM_BASE_URL/publik/*):
# GRAFIK_URL=off untuk melewati screenshot grafik per jam.
GRAFIK_URL=
# REKAP_CRO_URL=
# RENCANA_ESTIMASI_URL=
# REKAP_TK_PANEN_URL=

# Pengiriman Rekap TK Panen (/publik/rekap-tk-panen) di mode hourly (nonaktif by default)
# ENABLE_TK_PANEN=true
# TARGET_PHONE_TK=120363425038459858@g.us
# TK_PANEN_BELUM_LAPOR_JENIS=
