# Kredensial untuk WhatsApp Bot (Fonnte API)
# Salin file ini menjadi '.env' di server VPS Anda dan sesuaikan isinya.

# API Token dari Fonnte
WA_TOKEN=TokenFonnteAndaDiSini

# Target WhatsApp Group ID atau Nomor HP (Opsional, jika kosong default ke grup baru)
TARGET_PHONE=120363410041245092@g.us

# Alamat aplikasi AGRI-PAM. Kosongkan untuk memakai https://agri-pam.id.
# Selama pengujian v2, arahkan ke subdomain ujinya.
AGRIPAM_BASE_URL=https://v2.agri-pam.id

# Token baca halaman publik v2 (PUBLIC_READ_TOKEN milik API).
# Tanpa ini halaman publik tidak memuat data dan endpoint belum-lapor menjawab 401.
PUBLIC_READ_TOKEN=TokenBacaPublikDiSini

# Halaman grafik rekap per jam. Belum ada padanannya di v2, jadi biarkan kosong
# sampai halaman penggantinya dibuat; langkah itu akan dilewati.
GRAFIK_URL=
